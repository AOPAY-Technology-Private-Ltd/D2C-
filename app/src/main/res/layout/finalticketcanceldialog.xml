<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@android:color/white">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Success Icon -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/donecheckicon"
            android:layout_marginBottom="16dp"
            android:contentDescription="success" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ticket_cancelled"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_ticket"
            android:textSize="12sp"
            android:textColor="@color/edtblack"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginBottom="16dp" />

        <!-- Booking Ref -->
        <TextView
            android:id="@+id/bookingrefnumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Reference: BBB7E6ZT"
            android:textSize="14sp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black" />


        <!-- Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/the_refund"
            android:textSize="12sp"
            android:textColor="@color/edtblack"
            android:gravity="center"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp" />

        <!-- OK Button -->
        <TextView
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/buttonshape"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
