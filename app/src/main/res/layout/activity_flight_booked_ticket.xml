<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/flightdetailsheader">

    <ImageView
        android:id="@+id/back1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_centerVertical="true"
        android:layout_gravity="center"
        android:src="@drawable/backarrow"
        app:tint="@color/white"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/boardingpasstitle"
        app:layout_constraintTop_toBottomOf="@id/back1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booked Ticket"
        android:gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="-10dp"
        android:padding="10dp"
        android:textSize="18sp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        android:layout_margin="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintTop_toBottomOf="@+id/boardingpasstitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="left"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/fromairportcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp"
                        android:textColor="@color/primary_blue"/>

                    <TextView
                        android:id="@+id/fromcityname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/edtblack"
                        android:text="XXXXXX"/>

                    <TextView
                        android:id="@+id/fromdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xx ,xx xxxx"
                        android:textSize="12sp"
                        android:textColor="@color/edtblack"/>

                    <TextView
                        android:id="@+id/fromtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xx : xx"
                        android:textSize="12sp"
                        android:textColor="@color/edtblack"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/flightname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Air India"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"/>

                    <ImageView
                        android:id="@+id/flighticon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:textStyle="bold"
                        android:layout_margin="4dp"
                        android:textSize="18sp"
                        android:textColor="@color/edtblack"
                        android:src="@drawable/airindia"/>

                    <TextView
                        android:id="@+id/pnrNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXXXX"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/red"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Airline PNR"
                        android:textSize="12sp"
                        android:textColor="@color/edtblack"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="right"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/toairportcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX"
                        android:layout_marginRight="4dp"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue"/>

                    <TextView
                        android:id="@+id/tocityname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXXXX"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/edtblack"/>

                    <TextView
                        android:id="@+id/todate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xx ,xx xxxx"
                        android:textSize="12sp"
                        android:textColor="@color/edtblack"/>

                    <TextView
                        android:id="@+id/totime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xx : xx"
                        android:textSize="12sp"
                        android:textColor="@color/edtblack"/>

                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp">

                <ImageView
                    android:id="@+id/pointcircle"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:scaleType="fitXY"
                    android:layout_centerVertical="true"
                    android:src="@drawable/pointcircle"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:src="@drawable/dottedline"
                    app:tint="@color/primary_blue"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/pointcircle"
                    android:layout_toStartOf="@id/dotpoint"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/dotpoint"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/primary_blue"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"/>

                <ImageView
                    android:id="@+id/airplaneicon"
                    android:layout_width="140dp"
                    android:layout_height="80dp"
                    android:src="@drawable/airplane"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">


                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:gravity="left|center"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Passanger"
                        android:textColor="@color/edtblack"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/passangerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX"
                        android:textAllCaps="true"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                       />

                </LinearLayout>


                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:gravity="right|center"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flight"
                        android:textColor="@color/edtblack"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/flightnumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                       />

                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">


                <LinearLayout
                    android:layout_weight=".5"
                    android:layout_width="0dp"
                    android:gravity="left|center"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class"
                        android:textColor="@color/edtblack"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/classname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xxxx"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        />

                </LinearLayout>


                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Departure Terminal"
                        android:textColor="@color/edtblack"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/originterminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XX"
                        android:textSize="10sp"
                        android:gravity="start"
                        android:textColor="@color/black"
                        />

                </LinearLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/terminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arrival Terminal"
                        android:textAlignment="viewEnd"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/edtblack"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/arrivalterminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XX"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        app:layout_constraintLeft_toLeftOf="@+id/terminal"
                        app:layout_constraintTop_toBottomOf="@id/terminal"
                        app:layout_constraintRight_toRightOf="@+id/terminal" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/leftcard"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentLeft="true"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary_blue"
                    app:cardCornerRadius="40dp"
                    android:layout_marginLeft="-10dp"/>


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:src="@drawable/dottedline"
                    app:tint="@color/primary_blue"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/leftcard"
                    android:layout_toStartOf="@id/rightcard"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/rightcard"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="-10dp"
                    app:cardBackgroundColor="@color/primary_blue"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="40dp"/>

            </RelativeLayout>


            <ImageView
                android:id="@+id/generatebarcode"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:layout_margin="20dp" />



            <LinearLayout
                android:id="@+id/downloadticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/buttonshape"
                app:layout_constraintTop_toBottomOf="@+id/extraofferList">

                <TextView
                    android:text="@string/downloadticket"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="10dp"/>


            </LinearLayout>


        </LinearLayout>



    </androidx.cardview.widget.CardView>







</androidx.constraintlayout.widget.ConstraintLayout>