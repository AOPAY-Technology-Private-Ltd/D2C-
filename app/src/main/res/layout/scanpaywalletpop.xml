<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/select_payment_method"
            android:textColor="@color/edtblack"
            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/cross"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:padding="3dp"
            android:src="@drawable/cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pickupdroplayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="10dp"
            android:visibility="gone"
            android:background="@color/travelcardcolor"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toBottomOf="@+id/cross">

            <ImageView
                android:id="@+id/calendaricon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/calendaricon"
                app:tint="@color/primary_blue"
                android:scaleType="fitXY"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>

            <TextView
                android:id="@+id/traveldate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 March 2026"
                android:textSize="14sp"
                android:layout_marginLeft="3dp"
                android:textColor="@color/actionbarcolor"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintLeft_toRightOf="@+id/calendaricon"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/companyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="VRL Travels"
                android:textColor="@color/edtblack"
                android:textSize="17sp"
                android:layout_marginLeft="3dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/traveldate"/>

            <LinearLayout
                android:id="@+id/fromtocitylayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_marginLeft="3dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/companyName"
                android:layout_gravity="center">


                <TextView
                    android:id="@+id/fromcityname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delhi"
                    android:textSize="15sp"
                    android:textColor="@color/edtsubblack"
                    android:fontFamily="@font/roboto_medium"/>

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/gpsbusicon"
                    android:layout_marginLeft="10dp"
                    android:padding="2dp" />

                <TextView
                    android:id="@+id/tocityname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jaipur"
                    android:textSize="15sp"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/edtsubblack"
                    android:fontFamily="@font/roboto_medium"/>

            </LinearLayout>

            <TextView
                android:id="@+id/busticketAmounttxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 1000"
                android:textSize="17sp"
                android:paddingVertical="6dp"
                android:textColor="@color/edtblack"
                android:fontFamily="@font/roboto_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/paymentOptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/editouterborder"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pickupdroplayout">


            <LinearLayout
                android:id="@+id/walletLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:padding="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <RadioButton
                    android:id="@+id/walletButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">
                </RadioButton>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        app:tint="@color/primary_blue"
                        android:padding="3dp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/walleticon"/>


                    <TextView
                        android:id="@+id/wallettxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_via_wallet"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/edtblack"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                    <TextView
                        android:id="@+id/walletsubtxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant and secure payment"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/edtsubblack"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@id/wallettxt"
                        app:layout_constraintLeft_toLeftOf="parent"/>


                    <TextView
                        android:id="@+id/balancebtxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Balance"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/edtsubblack"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@id/walletsubtxt"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                    <TextView
                        android:id="@+id/balanceamtbtxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 1000"
                        android:paddingVertical="3dp"
                        android:textSize="15sp"
                        android:textColor="@color/green"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginLeft="5dp"
                        app:layout_constraintTop_toTopOf="@id/balancebtxt"
                        app:layout_constraintLeft_toRightOf="@id/balancebtxt"
                        app:layout_constraintBottom_toBottomOf="@id/balancebtxt" />

                    <TextView
                        android:id="@+id/insufficientbtxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/insufficient_balance"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/red"
                        android:textSize="13sp"
                        android:paddingVertical="3dp"
                        app:layout_constraintTop_toTopOf="@id/wallettopuplayout"
                        app:layout_constraintTop_toBottomOf="@id/balanceamtbtxt"
                        app:layout_constraintBottom_toBottomOf="@id/wallettopuplayout"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                    <TextView
                        android:id="@+id/insufficientAmounttxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 400"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/red"
                        android:textSize="13sp"
                        android:layout_marginLeft="5dp"
                        app:layout_constraintTop_toTopOf="@id/wallettopuplayout"
                        app:layout_constraintLeft_toRightOf="@id/insufficientbtxt"
                        app:layout_constraintBottom_toBottomOf="@id/wallettopuplayout" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/wallettopuplayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        app:layout_constraintLeft_toRightOf="@+id/insufficientAmounttxt"
                        app:layout_constraintTop_toBottomOf="@+id/balanceamtbtxt"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="3dp"
                            android:paddingHorizontal="3dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            android:background="@drawable/selectedfrombox">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/wallet_top_up"
                                android:gravity="center"
                                android:textColor="@color/primary_blue"
                                android:layout_marginLeft="3dp"
                                android:fontFamily="@font/roboto_medium"
                                android:layout_gravity="center"/>

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/arrowdown"
                                android:rotation="270"
                                android:gravity="center"
                                app:tint="@color/primary_blue"
                                android:layout_gravity="center"/>

                        </LinearLayout>



                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/proceedBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/buttonshape"
            android:gravity="center"
            android:paddingHorizontal="30dp"
            android:paddingVertical="7dp"
            android:text="@string/pay"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/paymentOptionCard"
            tools:layout_editor_absoluteX="9dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>