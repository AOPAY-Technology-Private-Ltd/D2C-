<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


           <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/continfo"
                android:textColor="@color/edtblack"
                android:textSize="20sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/cross"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:padding="3dp"
            android:src="@drawable/cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:background="@drawable/editouterborder"
        android:paddingBottom="50dp"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ticketmsg"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/edtsubblack"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="30dp">


            <EditText
                android:id="@+id/mail_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/mailid"
                android:textSize="14sp"
                android:fontFamily="@font/roboto_regular"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:background="@drawable/editouterborder"
                android:layout_marginTop="10dp"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/mob_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/mob"
                android:textSize="14sp"
                android:maxLength="10"
                android:fontFamily="@font/roboto_regular"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:background="@drawable/editouterborder"
                android:layout_marginTop="10dp"
                android:padding="10dp"/>


        </LinearLayout>


        <LinearLayout
            android:id="@+id/confirmbutton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/buttonshape"
            app:layout_constraintTop_toBottomOf="@+id/extraofferList">

            <TextView
                android:text="@string/cnfrm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="10dp"/>


        </LinearLayout>




    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>