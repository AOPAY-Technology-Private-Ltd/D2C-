<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.activity.wallet.WalletTopUpPage">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bgcolor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backicon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:padding="4dp"
                android:src="@drawable/backarrow"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/wallet_top_up"
                android:textColor="@color/edtblack"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/backicon"
                app:layout_constraintLeft_toRightOf="@+id/backicon"
                app:layout_constraintTop_toTopOf="@+id/backicon" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/walletamountlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/headerlayout">

            <LinearLayout
                android:id="@+id/adultlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:id="@+id/adultcount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/roboto_regular"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="3dp"
                    android:text="@string/available_balance"/>

            </LinearLayout>



            <LinearLayout
                android:id="@+id/infantlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/walletAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="3dp"
                    android:layout_marginLeft="5dp"
                    android:text="₹ 6000"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/enteramountlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="6dp"
            app:layout_constraintTop_toBottomOf="@+id/walletamountlayout">

            <TextView
                android:id="@+id/titlewallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/edtblack"
                android:fontFamily="@font/roboto_bold"
                android:paddingVertical="6dp"
                android:paddingHorizontal="3dp"
                app:layout_constraintTop_toTopOf="parent"
                android:text="You can add up to ₹ 10,000"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:paddingHorizontal="10dp"
                app:layout_constraintTop_toBottomOf="@id/titlewallet"
                android:background="@drawable/walletborder">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Amount"
                    android:textColor="@color/edtblack"
                    android:alpha=".8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹"
                        android:textColor="@color/edtblack"
                        android:alpha=".8"
                        android:textSize="20sp"/>

                    <EditText
                        android:id="@+id/enterAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="300"
                        android:background="@null"
                        android:layout_marginLeft="5dp"
                        android:textColor="@color/edtblack"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="25sp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/errormsgforamount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginHorizontal="15dp"
            android:paddingVertical="3dp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/red"
            android:text="Amount exceeds limit. Please enter ₹10,000 or less."
            app:layout_constraintTop_toBottomOf="@+id/enteramountlayout"/>

        <LinearLayout
            android:id="@+id/recommendedlayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="10dp"
            android:layout_marginHorizontal="13dp"
            android:padding="15dp"
            android:elevation="6dp"
            android:background="@drawable/recommendedbackimage"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/errormsgforamount">

            <LinearLayout
                android:id="@+id/amountlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="7dp"
                android:paddingHorizontal="10dp"
                android:elevation="5dp"
                android:background="@drawable/boxforrecommendedamt"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/recommendamount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹200"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/secondary_blue_dark"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recommended"
                    android:textColor="@color/edtblack"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/recommendedtxtmsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/is_the_recommended"
                    android:textColor="@color/edtblack"
                    android:textSize="11sp" />
            </LinearLayout>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendedAmountShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="12dp"
            tools:listitem="@layout/wallet_recommended_amount_item_layout"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/recommendedlayout"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messagetxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15sp"
            android:layout_marginTop="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recommendedAmountShow">

            <ImageView
                android:id="@+id/infoicon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/infoicon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>

            <TextView
                android:id="@+id/txtmsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginLeft="5dp"
                android:text="Recommended amount to make your next transaction in 1-click"
                android:textColor="@color/edtblack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/infoicon"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/proceedBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:background="@drawable/buttonshape"
            android:gravity="center"
            android:layout_marginHorizontal="15dp"
            android:paddingHorizontal="30dp"
            android:paddingVertical="7dp"
            android:text="@string/continues"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/messagetxt"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>