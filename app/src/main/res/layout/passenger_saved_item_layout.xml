<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RadioButton
        android:id="@+id/radiobutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Annu"
        app:layout_constraintTop_toTopOf="@+id/radiobutton"
        app:layout_constraintLeft_toRightOf="@id/radiobutton"
        app:layout_constraintBottom_toBottomOf="@id/radiobutton"/>

    <LinearLayout
        android:id="@+id/genderagelayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@+id/userName"
        app:layout_constraintTop_toBottomOf="@+id/userName">

        <TextView
            android:id="@+id/gender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginRight="5dp"
            android:text="Female"/>

        <androidx.cardview.widget.CardView
            android:layout_width="10dp"
            android:layout_height="10dp"
            app:cardCornerRadius="20dp"
            android:alpha=".2"
            android:padding="4dp"
            app:cardBackgroundColor="@color/edtsubblack"/>

        <TextView
            android:id="@+id/age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginLeft="5dp"
            android:text="25 yr"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/seatlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="3dp"
        android:paddingBottom="5dp"
        app:layout_constraintStart_toStartOf="@+id/genderagelayout"
        app:layout_constraintTop_toBottomOf="@+id/genderagelayout">

        <TextView
            android:id="@+id/seatassigned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/green"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginRight="5dp"
            android:text="Seat Assigned :"/>

        <TextView
            android:id="@+id/seat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="@font/roboto_medium"
            android:text="3LB"
            android:textColor="@color/edtblack"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:background="@color/backgroundcolor"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/seatlayout"/>

    <ImageView
        android:id="@+id/deleteitem"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:padding="3dp"
        android:layout_marginRight="10dp"
        android:alpha=".8"
        android:background="@drawable/unselctedcircle"
        android:src="@drawable/deleteicon"
        app:layout_constraintTop_toTopOf="@+id/userName"
        app:layout_constraintTop_toBottomOf="@+id/seatlayout"
        app:layout_constraintRight_toRightOf="parent"/>

    <ImageView
        android:id="@+id/edititem"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:padding="6dp"
        android:layout_marginRight="10dp"
        android:alpha=".8"
        android:src="@drawable/editicon"
        android:background="@drawable/unselctedcircle"
        app:layout_constraintRight_toLeftOf="@id/deleteitem"
        app:layout_constraintTop_toTopOf="@+id/userName"
        app:layout_constraintTop_toBottomOf="@+id/seatlayout"
        />

</androidx.constraintlayout.widget.ConstraintLayout>