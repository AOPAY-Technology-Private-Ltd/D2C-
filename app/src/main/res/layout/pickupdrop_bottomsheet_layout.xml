<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/busdetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Bus Details"
        android:textColor="@color/edtblack"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/cancelIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:padding="3dp"
        android:src="@drawable/cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pickupdroplayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/editouterborder"
        android:paddingHorizontal="6dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@+id/busdetails">

        <TextView
            android:id="@+id/companyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:text="VRL Travels"
            android:textColor="@color/edtblack"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          app:layout_constraintTop_toBottomOf="@+id/companyName">

          <ImageView
              android:id="@+id/pickupicon"
              android:layout_width="30dp"
              android:layout_height="30dp"
              android:src="@drawable/doticon"
              android:padding="4dp"
              app:layout_constraintLeft_toLeftOf="parent"
              app:layout_constraintTop_toTopOf="parent"/>

          <View
              android:layout_width="2dp"
              android:layout_height="0dp"
              app:layout_constraintLeft_toLeftOf="@id/pickupicon"
              app:layout_constraintRight_toRightOf="@id/pickupicon"
              app:layout_constraintTop_toBottomOf="@id/pickupicon"
              app:layout_constraintBottom_toTopOf="@id/droppointicon"
              android:background="@drawable/vertical_dashline" />

          <ImageView
              android:id="@+id/droppointicon"
              android:layout_width="30dp"
              android:layout_height="30dp"
              android:padding="4dp"
              app:layout_constraintLeft_toLeftOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"
              android:src="@drawable/locationicon"/>

          <LinearLayout
              android:id="@+id/pickuplayout"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginLeft="5dp"
              app:layout_constraintRight_toRightOf="parent"
              app:layout_constraintLeft_toRightOf="@+id/pickupicon"
              app:layout_constraintTop_toTopOf="parent">

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/roboto_medium"
                      android:text="@string/pickup_point"
                      android:textColor="@color/footer_unselected" />

                  <TextView
                      android:id="@+id/pickupPoint_datetime"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:text="6:30, 09 February"
                      android:gravity="right"
                      android:textColor="@color/edtblack"
                      android:fontFamily="@font/roboto_medium"
                      android:textSize="13sp" />

              </LinearLayout>


              <TextView
                  android:id="@+id/pickupPoint"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="3dp"
                  android:text="Selected Pickup Point"
                  android:textColor="@color/edtsubblack"
                  android:textSize="14sp" />

              <TextView
                  android:id="@+id/fromcityname"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/roboto_medium"
                  android:text="Delhi"
                  android:textColor="@color/edtsubblack"
                  android:textSize="15sp" />


          </LinearLayout>

          <LinearLayout
              android:id="@+id/droplayout"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="10dp"
              android:layout_marginLeft="5dp"
              android:orientation="vertical"
              app:layout_constraintRight_toRightOf="parent"
              app:layout_constraintLeft_toRightOf="@id/droppointicon"
              app:layout_constraintTop_toBottomOf="@+id/pickuplayout">

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/roboto_medium"
                      android:text="@string/drop_point"
                      android:textColor="@color/footer_unselected" />

                  <TextView
                      android:id="@+id/dropPoint_datetime"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:text="6:30, 09 February"
                      android:gravity="right"
                      android:textColor="@color/edtblack"
                      android:fontFamily="@font/roboto_medium"
                      android:textSize="13sp" />

              </LinearLayout>


              <TextView
                  android:id="@+id/dropPoint"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="3dp"
                  android:text="Selected Pickup Point"
                  android:textColor="@color/edtsubblack"
                  android:textSize="14sp" />

              <TextView
                  android:id="@+id/tocityname"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/roboto_medium"
                  android:text="Delhi"
                  android:textColor="@color/edtsubblack"
                  android:textSize="15sp" />


          </LinearLayout>



      </androidx.constraintlayout.widget.ConstraintLayout>





    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@+id/pickupdroplayout"/>

</androidx.constraintlayout.widget.ConstraintLayout>