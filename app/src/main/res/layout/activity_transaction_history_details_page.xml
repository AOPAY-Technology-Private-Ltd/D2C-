<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.activity.transactionhistory.TransactionHistoryDetailsPage">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgcolor">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerlayout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backicon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/backarrow"
                android:layout_margin="10dp"
                android:padding="4dp"
                app:tint="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/transactiontitlehistory"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:gravity="center"
                android:fontFamily="@font/roboto_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:padding="6dp"
                android:src="@drawable/more"
                app:tint="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/headerlayout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/toplayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardUseCompatPadding="true"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/headerlayout"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:padding="5dp"
                            android:src="@drawable/passengercheckicon"/>

                        <TextView
                            android:id="@+id/remarks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payout"
                            android:textSize="18sp"
                            android:textColor="@color/edtblack"
                            android:fontFamily="@font/roboto_medium"/>

                        <TextView
                            android:id="@+id/refId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BTERF00640"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/edtblack"
                            android:fontFamily="@font/roboto_medium"/>


                        <TextView
                            android:id="@+id/date"
                            android:layout_gravity="right"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apr 15,2026, 12:11 PM"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/button_text_gray"
                            android:fontFamily="@font/roboto_regular"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/debitedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardUseCompatPadding="true"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/toplayout">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Debited From"
                            android:textSize="16sp"
                            android:padding="10dp"
                            android:textColor="@color/edtsubblack"
                            android:fontFamily="@font/roboto_medium"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/namecard"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                app:cardCornerRadius="110dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:cardBackgroundColor="@color/actionbarcolor"
                                android:layout_gravity="center">

                                <TextView
                                    android:id="@+id/receiverNameFirstCharacter"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:layout_gravity="center"
                                    android:padding="4sp"
                                    android:text="A"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:gravity="center"
                                    android:src="@drawable/correct" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toRightOf="@+id/namecard"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/userName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Annu (BOS-1249)"
                                    android:fontFamily="@font/roboto_bold"
                                    android:textSize="14sp"
                                    android:textColor="@color/black"/>

                                <TextView
                                    android:id="@+id/contactNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1234567890"
                                    android:textSize="15sp"
                                    android:textColor="@color/black"
                                    android:alpha=".7"
                                    android:fontFamily="@font/roboto_medium"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/debitamt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹ 1 Debited"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textSize="@dimen/dimen_12sp"
                                android:layout_marginRight="10dp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/roboto_medium"
                                android:backgroundTint="@color/inputtext_boxstroke"
                                android:background="@drawable/buttonshape"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintRight_toRightOf="parent"/>



                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/transferFromMsg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:alpha=".8"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="Your account has been debited by ₹115.00 for Bus Ticket booking. Ref No: BBB7HHW4."/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/creditcard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardUseCompatPadding="true"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/debitedCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Credited To"
                            android:textSize="16sp"
                            android:padding="10dp"
                            android:textColor="@color/edtsubblack"
                            android:fontFamily="@font/roboto_medium"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <TextView
                            android:id="@+id/transfertoMsg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:alpha=".8"
                            android:fontFamily="@font/roboto_regular"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="Admin credited ₹115.00 for Bus Ticket booking. Ref No: BBB7HHW4."/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/creditamt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹ 1 Credited"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textSize="@dimen/dimen_12sp"
                                android:layout_marginRight="10dp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/roboto_medium"
                                android:backgroundTint="@color/inputtext_boxstroke"
                                android:background="@drawable/buttonshape"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintRight_toRightOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardUseCompatPadding="true"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/creditcard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Transaction ID"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:layout_weight="1"
                                android:id="@+id/transactionid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="BTERF00640"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Reference ID"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:layout_weight="1"
                                android:id="@+id/referenceid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="000000000786"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Remark"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:layout_weight="1"
                                android:id="@+id/remark"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Payout"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Opening balance"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:layout_weight="1"
                                android:id="@+id/openingbalance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="₹ 500"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/grey"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Closing balance"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:layout_weight="1"
                                android:id="@+id/closingbalance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="₹ 500"
                                android:textSize="16sp"
                                android:padding="10dp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>