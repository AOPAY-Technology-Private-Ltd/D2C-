<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/travellerTypeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/alertmsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:layout_marginTop="10dp"
        android:background="@color/heightalert"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/infoicon"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textSize="12sp"
            android:textColor="@color/edtblack"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginRight="10dp"
            android:text="Name must be as per Goverment ID Proof"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/adultCardlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardUseCompatPadding="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/alertmsg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adulttitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:background="@color/travelcardcolor"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/Addtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adult"
                    android:textColor="@color/edtsubblack"
                    android:textSize="16sp"
                    android:layout_marginLeft="5dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_marginHorizontal="7dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/roboto_medium"/>

                <ImageView
                    android:id="@+id/adultarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrowup"
                    android:layout_marginRight="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adultsubdetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toBottomOf="@+id/adulttitle">

                <RadioGroup
                    android:id="@+id/adultradiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:layout_marginHorizontal="4dp">

                    <RadioButton
                        android:id="@+id/adultmale"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Mr."
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                    <RadioButton
                        android:id="@+id/adultfemale"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ms."
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                    <RadioButton
                        android:id="@+id/adultfemalemaried"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Mrs."
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/firstnamelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    app:layout_constraintTop_toBottomOf="@+id/adultradiogroup">

                    <EditText
                        android:id="@+id/passengerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="First Name And Middle Name"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lastnamelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/firstnamelayout">

                    <EditText
                        android:id="@+id/passengerLName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Last Name"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/agelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/lastnamelayout">

                    <EditText
                        android:id="@+id/passengerAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Age: above 12 yrs "
                        android:inputType="number"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionDone"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passportnolayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/agelayout">

                    <EditText
                        android:id="@+id/passport_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportno"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passport_issuing_country_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/passportnolayout">

                    <EditText
                        android:id="@+id/passport_issuing_country"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportcountryname"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/passport_expire_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/passport_issuing_country_layout">

                    <TextView
                        android:id="@+id/passport_expire_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportexpiredate"
                        android:inputType="text"
                        android:paddingVertical="5dp"
                        android:textColor="@color/edtblack"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                    <ImageView
                        android:id="@+id/passport_expire_date_calander"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/calendar"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <CheckBox
                    android:id="@+id/checkforsave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/edtblack"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="@string/save_this_detail_for_future_bookings"
                    app:layout_constraintTop_toBottomOf="@+id/passport_expire_date_layout"/>

                <LinearLayout
                    android:id="@+id/adultAddBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/buttonshape"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/checkforsave"
                    android:layout_marginBottom="30dp">

                    <TextView
                        android:id="@+id/nextbutton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/add"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/childCardlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardUseCompatPadding="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/adultCardlayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/childtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:background="@color/travelcardcolor"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Child"
                    android:textColor="@color/edtsubblack"
                    android:textSize="16sp"
                    android:layout_marginLeft="5dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_marginHorizontal="7dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/roboto_medium"/>

                <ImageView
                    android:id="@+id/childarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrowdown"
                    android:layout_marginRight="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/childContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/childtitle">

                <RadioGroup
                    android:id="@+id/childradiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:layout_marginHorizontal="4dp">


                    <RadioButton
                        android:id="@+id/childfemale"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ms."
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                    <RadioButton
                        android:id="@+id/childmale"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Mstr."
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/childNamelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    app:layout_constraintTop_toBottomOf="@+id/childradiogroup">

                    <EditText
                        android:id="@+id/childpassengerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="First Name And Middle Name"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/childLNamelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/childNamelayout">

                    <EditText
                        android:id="@+id/childPassengerLName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Last Name"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/childagelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/childLNamelayout">

                    <EditText
                        android:id="@+id/childpassengerAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Age: from 2 - 12 yrs"
                        android:inputType="number"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionDone"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/childpassportnolayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/childagelayout">

                    <EditText
                        android:id="@+id/child_passport_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportno"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/child_passport_issuing_country_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/childpassportnolayout">

                    <EditText
                        android:id="@+id/child_passport_issuing_country"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportcountryname"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/child_passport_expire_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/child_passport_issuing_country_layout">

                    <TextView
                        android:id="@+id/child_passport_expire_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/passportexpiredate"
                        android:inputType="text"
                        android:paddingVertical="5dp"
                        android:textColor="@color/edtblack"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                    <ImageView
                        android:id="@+id/child_passport_expire_date_calander"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/calendar"
                        android:layout_gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <CheckBox
                    android:id="@+id/childcheckforsave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/edtblack"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="@string/save_this_detail_for_future_bookings"
                    app:layout_constraintTop_toBottomOf="@+id/child_passport_expire_date_layout"/>

                <LinearLayout
                    android:id="@+id/childAddBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/buttonshape"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/childcheckforsave"
                    android:layout_marginBottom="30dp">

                    <TextView
                        android:id="@+id/childnextbutton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/add"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/infantCardlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardUseCompatPadding="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@+id/childCardlayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/infantttitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:background="@color/travelcardcolor"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/infantAddtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Infant"
                    android:textColor="@color/edtsubblack"
                    android:textSize="16sp"
                    android:layout_marginLeft="5dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_marginHorizontal="7dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/roboto_medium"/>

                <ImageView
                    android:id="@+id/infantarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrowdown"
                    android:layout_marginRight="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/infantContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/infantttitle">

            <RadioGroup
                android:id="@+id/infantradiogroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginHorizontal="4dp">

                <RadioButton
                    android:id="@+id/infantfemale"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ms."
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto_regular"/>

                <RadioButton
                    android:id="@+id/infantmale"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Mstr."
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto_regular"/>

            </RadioGroup>

            <LinearLayout
                android:id="@+id/infantfirstnamelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                app:layout_constraintTop_toBottomOf="@+id/infantradiogroup">

                <EditText
                    android:id="@+id/infantpassengerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="First Name And Middle Name"
                    android:inputType="text"
                    android:textColor="@color/edtblack"
                    android:textSize="15sp"
                    android:imeOptions="actionNext"
                    android:background="@null"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/infantLNamelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/infantfirstnamelayout">

                <EditText
                    android:id="@+id/infantPassengerLName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="Last Name"
                    android:inputType="text"
                    android:textColor="@color/edtblack"
                    android:textSize="15sp"
                    android:imeOptions="actionNext"
                    android:background="@null"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/infantagelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/infantLNamelayout">

                <EditText
                    android:id="@+id/infantpassengerAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="Age: Under 2 yrs"
                    android:inputType="number"
                    android:textColor="@color/edtblack"
                    android:textSize="15sp"
                    android:imeOptions="actionDone"
                    android:background="@null"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/infantpassportnolayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/infantagelayout">

                <EditText
                    android:id="@+id/infant_passport_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/passportno"
                    android:inputType="text"
                    android:textColor="@color/edtblack"
                    android:textSize="15sp"
                    android:imeOptions="actionNext"
                    android:background="@null"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/infant_passport_issuing_country_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/infantpassportnolayout">

                <EditText
                    android:id="@+id/infant_passport_issuing_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/passportcountryname"
                    android:inputType="text"
                    android:textColor="@color/edtblack"
                    android:textSize="15sp"
                    android:imeOptions="actionNext"
                    android:background="@null"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/infant_passport_expire_date_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/fromtoback"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/infant_passport_issuing_country_layout">

                <TextView
                    android:id="@+id/infant_passport_expire_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/passportexpiredate"
                    android:inputType="text"
                    android:paddingVertical="5dp"
                    android:textColor="@color/edtblack"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textSize="15sp"
                    android:imeOptions="actionNext"
                    android:background="@null"/>

                <ImageView
                    android:id="@+id/infant_passport_expire_date_calander"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/calendar"
                    android:layout_gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <CheckBox
                android:id="@+id/infantcheckforsave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/edtblack"
                android:layout_marginHorizontal="3dp"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="@string/save_this_detail_for_future_bookings"
                app:layout_constraintTop_toBottomOf="@+id/infant_passport_expire_date_layout"/>

            <LinearLayout
                android:id="@+id/infantAddBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/buttonshape"
                android:layout_marginHorizontal="5dp"
                app:layout_constraintTop_toBottomOf="@+id/infantcheckforsave"
                android:layout_marginBottom="30dp">

                <TextView
                    android:id="@+id/infantnextbutton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/add"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>