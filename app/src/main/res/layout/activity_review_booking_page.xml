<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.activity.travel.AllBusModule.ReviewBookingPage">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bgcolor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backicon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:padding="4dp"
                android:src="@drawable/backarrow"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="Review Booking"
                android:textColor="@color/edtblack"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/backicon"
                app:layout_constraintLeft_toRightOf="@+id/backicon"
                app:layout_constraintTop_toTopOf="@+id/backicon" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedscrollview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerlayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="100dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pickupdroplayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/editouterborder"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/companyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:text="VRL Travels"
                        android:textColor="@color/edtblack"
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:layout_constraintTop_toBottomOf="@+id/companyName">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/fromcityname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delhi"
                                android:textSize="15sp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:id="@+id/pickupPoint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/edtsubblack"
                                android:textSize="14sp"
                                android:layout_marginTop="3dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Selected Pickup Point"/>

                            <TextView
                                android:id="@+id/pickupPoint_datetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/disablebuttoncolor"
                                android:fontFamily="@font/roboto_regular"
                                android:textSize="13sp"
                                android:layout_marginTop="6dp"
                                android:text="6:30, 09 February"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tocityname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jaipur"
                                android:textSize="15sp"
                                android:textColor="@color/edtsubblack"
                                android:fontFamily="@font/roboto_medium"/>

                            <TextView
                                android:id="@+id/dropPoint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/edtsubblack"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:layout_marginTop="3dp"
                                android:text="Selected Pickup Point"/>

                            <TextView
                                android:id="@+id/dropPoint_datetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/disablebuttoncolor"
                                android:fontFamily="@font/roboto_regular"
                                android:textSize="13sp"
                                android:layout_marginTop="6dp"
                                android:text="6:30, 09 February"/>

                        </LinearLayout>


                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailstxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textSize="13sp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/primary_blue"
                        android:fontFamily="@font/roboto_regular"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pessangerDetailslayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/editouterborder"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/pickupdroplayout">

                    <TextView
                        android:id="@+id/pessangertitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:text="Passenger Details"
                        android:textColor="@color/edtblack"
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:layout_constraintTop_toBottomOf="@+id/pessangertitle">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/passengerList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:listitem="@layout/item_booking_passenger"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>


                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/contactDetailsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/editouterborder"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/pessangerDetailslayout">

                    <TextView
                        android:id="@+id/contacttitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/enter_contact"
                        android:textColor="@color/edtblack"
                        android:textSize="17sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/contacttitle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:background="@drawable/fromtoback">
                            <EditText
                                android:id="@+id/passengerMobileNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:hint="Mobile Number"
                                android:textSize="14sp"
                                android:paddingVertical="6dp"
                                android:textColor="@color/edtblack"
                                android:inputType="number"
                                android:maxLength="10"
                                android:focusable="true"
                                android:fontFamily="@font/roboto_regular"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/fromtoback">
                            <EditText
                                android:id="@+id/passengerMailId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:textSize="14sp"
                                android:paddingVertical="6dp"
                                android:textColor="@color/edtblack"
                                android:fontFamily="@font/roboto_regular"
                                android:hint="Email ID"
                                android:inputType="textEmailAddress"/>
                        </LinearLayout>


                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectedseatLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/farebreakup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/totalfaretxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:text="@string/total_fare"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="14sp"
                    android:textColor="@color/edtsubblack"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginLeft="3dp"
                    android:src="@drawable/infoicon"
                    android:padding="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/totalfaretxt"/>

                <TextView
                    android:id="@+id/finalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="start"
                    android:text="₹ 6000"
                    android:textSize="16sp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/edtblack"
                    android:fontFamily="@font/roboto_medium"
                    android:textAllCaps="false"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/totalfaretxt"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:paddingStart="10sp"
                    android:text="+taxes"
                    android:textAllCaps="false"
                    android:textColor="@color/edtsubblack"
                    android:textSize="14sp"
                    android:paddingVertical="5dp"
                    android:fontFamily="@font/roboto_regular"
                    app:layout_constraintLeft_toRightOf="@+id/finalAmount"
                    app:layout_constraintTop_toBottomOf="@+id/totalfaretxt"/>

            </androidx.constraintlayout.widget.ConstraintLayout>



            <TextView
                android:id="@+id/proceedBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/buttonshape"
                android:gravity="center"
                android:paddingHorizontal="30dp"
                android:paddingVertical="7dp"
                android:text="@string/proceed"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/farebreakup"
                app:layout_constraintBottom_toBottomOf="@+id/farebreakup"
                app:layout_constraintRight_toRightOf="parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@+id/proceedBtn"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>