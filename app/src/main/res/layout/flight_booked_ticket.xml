<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgcolor"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backicon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:padding="4dp"
            android:src="@drawable/backarrow"
            android:visibility="invisible"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="Booked Ticket"
            android:textColor="@color/edtblack"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/backicon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/backicon" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@+id/headerlayout"
        app:layout_constraintBottom_toTopOf="@id/bottomcard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topheaderlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ticket_gradient"
            android:paddingBottom="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/flightName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Air India"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/confirmcard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                app:cardCornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="@id/flightName"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/flightName">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:background="@drawable/confirmedback"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/confirmed"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/fromAirportCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/roboto_bold"
                android:text="DEL"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintLeft_toLeftOf="@+id/flightName"
                app:layout_constraintRight_toRightOf="@+id/flightName"
                app:layout_constraintTop_toBottomOf="@+id/flightName" />

            <TextView
                android:id="@+id/toAirportCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/roboto_bold"
                android:text="BOM"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintLeft_toLeftOf="@+id/confirmcard"
                app:layout_constraintRight_toRightOf="@+id/confirmcard"
                app:layout_constraintTop_toBottomOf="@+id/confirmcard" />

            <RelativeLayout
                android:id="@+id/planlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="-25dp"
                app:layout_constraintTop_toBottomOf="@+id/toAirportCode">

                <TextView
                    android:id="@+id/pointcircle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="4dp"
                    android:text="Departure"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/dotpoint"
                    android:layout_toEndOf="@id/pointcircle"
                    android:alpha=".6"
                    android:src="@drawable/dottedline"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/dotpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="4dp"
                    android:text="Arrival"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/airplaneicon"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/plan3d" />

            </RelativeLayout>

            <TextView
                android:id="@+id/departureDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:fontFamily="@font/roboto_medium"
                android:text="11:20"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/planlayout" />

            <TextView
                android:id="@+id/departureDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:alpha=".8"
                android:fontFamily="@font/roboto_medium"
                android:text="FRI,12 March 2026"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/departureDate" />

            <TextView
                android:id="@+id/departureterminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:alpha=".8"
                android:fontFamily="@font/roboto_medium"
                android:text="Terminal 1"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/departureDay" />

            <TextView
                android:id="@+id/arrivalDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_medium"
                android:text="11:20"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/planlayout" />

            <TextView
                android:id="@+id/arrivalDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:alpha=".8"
                android:fontFamily="@font/roboto_medium"
                android:text="FRI,12 March 2026"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/departureDate" />

            <TextView
                android:id="@+id/arrivalterminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:alpha=".8"
                android:fontFamily="@font/roboto_medium"
                android:text="Terminal 3"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/departureDay" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/cardbottomdashimage"
            app:layout_constraintLeft_toLeftOf="@+id/centercard"
            app:layout_constraintRight_toRightOf="@+id/centercard"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="-4dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@+id/centercard"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/centercard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topheaderlayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bookedticketcolorgradient"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:id="@+id/boardingdetailslayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:elevation="10dp"
                    android:background="@drawable/editouterborder">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/boardingtxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Boarding Time"
                            android:textColor="@color/primary_blue"
                            android:textSize="14sp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/boardingtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="11:00"
                            android:textColor="@color/edtblack"
                            android:textSize="14sp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/boardingtxt" />


                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/edtblack" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/classtxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Class"
                            android:textColor="@color/primary_blue"
                            android:textSize="14sp"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/travelclass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="11:00"
                            android:textColor="@color/edtblack"
                            android:textSize="14sp"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/classtxt" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/passengertitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSENGERS"
                    android:textColor="@color/primary_blue"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_margin="10dp"
                    android:padding="4dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/boardingdetailslayout" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/passengerdetailslayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp"
                    android:layout_marginHorizontal="12dp"
                    tools:itemCount="3"
                    tools:listitem="@layout/bookedpassenger_itemlayout"
                    app:layout_constraintTop_toBottomOf="@+id/passengertitle"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <ImageView
                    android:id="@+id/dashimage"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/dottedline"
                    app:layout_constraintTop_toBottomOf="@+id/passengerdetailslayout"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/leftcard"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/dashimage"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/bgcolor"
                    app:cardCornerRadius="40dp"
                    android:layout_marginLeft="-10dp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/rightcard"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/dashimage"
                    app:cardElevation="2dp"
                    app:layout_constraintRight_toRightOf="parent"
                    app:cardBackgroundColor="@color/bgcolor"
                    app:cardCornerRadius="40dp"
                    android:layout_marginRight="-10dp"/>

                <TextView
                    android:id="@+id/pnrtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/leftcard"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="@+id/view1"
                    android:paddingVertical="5dp"
                    android:textColor="@color/primary_blue"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="14sp"
                    android:elevation="1dp"
                    android:text="PNR"/>

                <TextView
                    android:id="@+id/boardingtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/rightcard"
                    app:layout_constraintRight_toRightOf="parent"
                    android:paddingVertical="5dp"
                    app:layout_constraintLeft_toLeftOf="@+id/view1"
                    android:textColor="@color/primary_blue"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="14sp"
                    android:elevation="1dp"
                    android:text="BOOKING ID"/>

                <LinearLayout
                    android:id="@+id/backlayoutshadow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="@+id/boardingtitle"
                    app:layout_constraintBottom_toBottomOf="@+id/bookingIDnumber"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/cardbottomshapebookedticket"/>

                <TextView
                    android:id="@+id/pnrnumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TPAGZ8123"
                    android:textColor="@color/edtblack"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="14sp"
                    android:padding="6dp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@+id/view"
                    app:layout_constraintRight_toRightOf="@+id/view1"
                    app:layout_constraintLeft_toLeftOf="parent"/>

                <TextView
                    android:id="@+id/bookingIDnumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TPAGZ8123"
                    android:textSize="14sp"
                    android:padding="6dp"
                    android:gravity="center"
                    android:textColor="@color/edtblack"
                    android:fontFamily="@font/roboto_bold"
                    app:layout_constraintLeft_toLeftOf="@+id/view1"
                    app:layout_constraintTop_toBottomOf="@+id/view"
                    app:layout_constraintRight_toRightOf="parent" />

                <View
                    android:id="@+id/view"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintLeft_toLeftOf="@+id/backlayoutshadow"
                    app:layout_constraintRight_toRightOf="@+id/backlayoutshadow"
                    app:layout_constraintTop_toBottomOf="@+id/boardingtitle"/>

                <View
                    android:id="@+id/view1"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/grey"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dashimage"
                    app:layout_constraintBottom_toBottomOf="@+id/backlayoutshadow"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>




    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomcard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="@color/cardcolor"
        app:cardCornerRadius="7dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:src="@drawable/infoicon"
                app:tint="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Note:"
                android:textColor="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/please_make"
                android:textColor="@color/secondary_blue_dark"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>