<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardnamefirstname"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="80dp"
            android:layout_margin="5dp"
            app:cardBackgroundColor="@color/cardcolor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/charactername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textColor="@color/primary_blue"
                android:layout_gravity="center"
                android:gravity="center"
                android:fontFamily="@font/roboto_medium"
                android:textSize="15sp"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/passengerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annu"
            android:textSize="16sp"
            android:textColor="@color/edtblack"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cardnamefirstname"/>

        <TextView
            android:id="@+id/passengerdetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 | Female | BBBYWEVU0"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/edtblack"
            android:alpha=".7"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintLeft_toRightOf="@+id/cardnamefirstname"
            app:layout_constraintTop_toBottomOf="@+id/passengerName"/>

        <TextView
            android:id="@+id/seatnumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12A"
            android:textSize="12sp"
            android:textColor="@color/primary_blue"
            android:layout_marginRight="20dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="10dp"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/selectedfrombox"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>