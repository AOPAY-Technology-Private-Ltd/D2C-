<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.activity.travel.AllBusModule.BusFilterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bgcolor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/cross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:src="@drawable/cancel"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/edtblack" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/sortfilters"
                android:textColor="@color/edtsubblack"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/cross"
                app:layout_constraintLeft_toRightOf="@+id/cross"
                app:layout_constraintTop_toTopOf="@+id/cross" />


            <TextView
                android:id="@+id/flightcount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="-7dp"
                android:text="80 Bus Found"
                android:textColor="@color/edtsubblack"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@+id/title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/bottomview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@+id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_alignParentBottom="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/flighttype"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/bus_type"
                            app:layout_constraintTop_toBottomOf="@+id/header" />

                        <LinearLayout
                            android:id="@+id/flighttypeoption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/flighttype">

                            <LinearLayout
                                android:id="@+id/aclayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/acicon"
                                    android:layout_width="50dp"
                                    android:layout_height="60dp"
                                    android:layout_gravity="center"
                                    android:padding="10dp"
                                    android:src="@drawable/coldicon" />

                                <TextView
                                    android:id="@+id/actxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="AC" />

                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight=".5" />


                            <LinearLayout
                                android:id="@+id/nonaclayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/nonacicon"
                                    android:layout_width="50dp"
                                    android:layout_height="60dp"
                                    android:layout_gravity="center"
                                    android:padding="10dp"
                                    android:src="@drawable/fire" />

                                <TextView
                                    android:id="@+id/nonactext"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="Non AC" />

                            </LinearLayout>


                        </LinearLayout>

                        <TextView
                            android:id="@+id/filterbytype"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/buttonshape"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="@string/filterflighttype"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@+id/header" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/departuretime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/depart"
                            app:layout_constraintTop_toBottomOf="@+id/flighttypeoption" />

                        <LinearLayout
                            android:id="@+id/topdepatureitemlayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/departuretime">


                            <LinearLayout
                                android:id="@+id/before6layout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/before6icon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:padding="14dp"
                                    android:src="@drawable/before6"/>

                                <TextView
                                    android:id="@+id/before6txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="Before 6 am" />

                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight=".3" />


                            <LinearLayout
                                android:id="@+id/after6amlayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/after6amimage"
                                    android:layout_width="50dp"
                                    android:layout_height="60dp"
                                    android:layout_gravity="center"
                                    android:padding="10dp"
                                    android:src="@drawable/sunrise" />

                                <TextView
                                    android:id="@+id/after6amtxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="6 am - 12 pm" />

                            </LinearLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bottomdepatureitemlayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/topdepatureitemlayout">


                            <LinearLayout
                                android:id="@+id/after12pmlayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/after12pmicon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:padding="14dp"
                                    android:src="@drawable/sun" />

                                <TextView
                                    android:id="@+id/after12pmtxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="12 pm - 6 pm" />

                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight=".3" />


                            <LinearLayout
                                android:id="@+id/after6pmlayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight=".5"
                                    android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/after6pmicon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:padding="14dp"
                                    android:src="@drawable/moon" />

                                <TextView
                                    android:id="@+id/after6pmtxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:padding="6dp"
                                    android:textColor="@color/edtsubblack"
                                    android:text="After 6 pm" />

                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/airlineschoos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/bus_operator"
                            app:layout_constraintTop_toBottomOf="@+id/bottomdepatureitemlayout" />

                        <LinearLayout
                            android:id="@+id/chooseairlines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/airlineschoos">


                            <LinearLayout
                                android:id="@+id/chooseairlineslayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <EditText
                                    android:id="@+id/searchairlines"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:hint="Choose Bus Operator"
                                    android:padding="10dp"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/showbusoperatorlist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@+id/chooseairlines"
                            tools:listitem="@layout/airlineslistitemlayot" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/boardingpointstxt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/boarding_point"
                            app:layout_constraintTop_toBottomOf="@+id/bottomdepatureitemlayout" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/airlineschoos">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <EditText
                                    android:id="@+id/searchboardingpoints"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:hint="Choose Bus Boarding Points"
                                    android:padding="10dp"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/showboardinglist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@+id/chooseairlines"
                            tools:listitem="@layout/airlineslistitemlayot" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:text="Dropping Points"
                            app:layout_constraintTop_toBottomOf="@+id/bottomdepatureitemlayout" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@+id/airlineschoos">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/editouterborder"
                                android:orientation="vertical">

                                <EditText
                                    android:id="@+id/searchdroppoints"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:hint="Choose Bus Dropping Points"
                                    android:padding="10dp"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/showbusdroplist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="20dp"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@+id/chooseairlines"
                            tools:listitem="@layout/airlineslistitemlayot" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:paddingVertical="10dp"
                            app:layout_constraintTop_toBottomOf="@+id/header">

                            <TextView
                                android:id="@+id/filterbyfliteoperator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/buttonshape"
                                android:gravity="center"
                                android:textSize="14sp"
                                android:padding="6dp"
                                android:text="@string/filter_your_bus"
                                android:textColor="@color/white"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/clearAllFilter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="20dp"
                                 android:background="@drawable/buttonshape"
                                android:gravity="center"
                                android:padding="6dp"
                                android:textSize="14sp"
                                android:text="@string/filterclear"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:layout_alignParentRight="true" />

                        </RelativeLayout>


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>


        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>