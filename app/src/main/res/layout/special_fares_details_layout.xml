<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/special_fares_optional"
        android:textColor="@color/edtblack"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/cancelIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:padding="3dp"
        android:src="@drawable/cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/detailslayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/editouterborder"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/defence_forces"
            android:textColor="@color/edtblack"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="6dp"
            android:paddingHorizontal="10dp"
            android:textColor="@color/edtblack"
            android:alpha=".8"
            android:text="@string/valid_for_retired"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:src="@drawable/dottedline"
            app:layout_constraintTop_toBottomOf="@+id/chargesdetailslayout" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="Students"
            android:textColor="@color/edtblack"
            android:paddingVertical="6dp"
            android:paddingHorizontal="10dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="6dp"
            android:paddingHorizontal="10dp"
            android:textColor="@color/edtblack"
            android:alpha=".8"
            android:text="@string/special_fares"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:src="@drawable/dottedline"
            app:layout_constraintTop_toBottomOf="@+id/chargesdetailslayout" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="Senior Citizens"
            android:paddingHorizontal="10dp"
            android:textColor="@color/edtblack"
            android:paddingVertical="6dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="6dp"
            android:textColor="@color/edtblack"
            android:alpha=".8"
            android:paddingHorizontal="10dp"
            android:text="@string/senior_citizens_of_"
            android:textSize="13sp" />


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/detailslayout"/>


</androidx.constraintlayout.widget.ConstraintLayout>