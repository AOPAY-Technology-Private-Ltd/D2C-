<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navmain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_blue_dark"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <RelativeLayout
                android:id="@+id/headerlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/profileCard"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="104dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:id="@+id/ownerPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:layout_gravity="center"
                            android:src="@drawable/user" />

                    </androidx.cardview.widget.CardView>

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/donecheckicon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignRight="@+id/profileCard"
                    android:layout_alignBottom="@+id/profileCard"
                    android:layout_marginTop="-3dp"
                    android:layout_marginRight="-15dp"
                    android:elevation="2dp"
                    android:padding="4dp"
                    android:src="@drawable/donecheckicon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:layout_toEndOf="@id/profileCard"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/customerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Name"
                        android:textColorHint="@color/white"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/customerNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8734526715"
                        android:textColor="@color/backgroundcolor"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/drawableclose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/backarrow"
                    app:tint="@color/white" />

            </RelativeLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/qrlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/headerlayout"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="20dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_margin="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountnumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="Account No : xxxxxxx"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/notgeneratedqrlayout"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="5dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="4dp">

                        <FrameLayout
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:background="@android:color/transparent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="4dp"
                                android:alpha=".4"
                                android:src="@drawable/qrcodescan" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha=".1"
                                android:background="@color/primary_blue" />

                            <ImageView
                                android:id="@+id/lockericon"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_below="@id/accountnumber"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center"
                                android:src="@drawable/lock"
                                app:tint="@color/secondary_blue_dark" />

                        </FrameLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/generatedqrlayout"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="5dp"
                        android:visibility="gone"
                        app:cardCornerRadius="4dp">

                        <FrameLayout
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:background="@android:color/transparent">

                            <ImageView
                                android:id="@+id/QRCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="4dp"
                                android:src="@drawable/qrcodescan" />

                        </FrameLayout>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/vpaid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/roboto_regular"
                            android:text="xxxxx@bankname"
                            android:textColor="@color/txtcolor"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/copyicon"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_marginLeft="7dp"
                            android:src="@drawable/copyicon" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bankbottomsheetcall"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/roboto_medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Generate QR Code"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="8dp" />

                    <LinearLayout
                        android:id="@+id/sharelayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/shareqrcode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="7dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="25dp"
                                    android:layout_margin="4dp"
                                    android:padding="2dp"
                                    android:src="@drawable/share" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Share QR"
                                    android:textColor="@color/black"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="5dp"
                            android:layout_height="0dp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/saveqrcode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="7dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="25dp"
                                    android:layout_margin="4dp"
                                    android:padding="2dp"
                                    android:src="@drawable/save" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="Save QR"
                                    android:textColor="@color/black"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:overScrollMode="never"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/qrlayout"/>

            <LinearLayout
                android:id="@+id/preferencelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10dp"
                android:padding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/recyclerView">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/settingicon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/settingnew"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginLeft="10dp"
                        android:layout_toEndOf="@id/settingicon"/>


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/securityicon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/securityicon"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/security"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginLeft="10dp"
                        android:layout_toEndOf="@id/securityicon"/>


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/helpsupporticon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/helpicon"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/help_and_support"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginLeft="10dp"
                        android:layout_toEndOf="@id/helpsupporticon"/>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/helpiconicon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/information"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_us"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_marginLeft="10dp"
                        android:layout_toEndOf="@id/helpiconicon"/>


                </RelativeLayout>


            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/switchlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="10dp"
                app:strokeWidth="0dp"
                android:padding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/preferencelayout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Biomatric Lock"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                          />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/llLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/fingerPrintLayout">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/roboto_medium"
                            android:text="@string/logout"
                            android:textColor="@color/red"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/msglayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@+id/switchlayout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/backgroundcolor"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="13sp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Powered by BOS Pvt. Ltd."/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/backgroundcolor"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="12sp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="India’s Smart Payment App"/>

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/indiaflag"
                        android:layout_gravity="center"
                        android:padding="4dp"
                        android:layout_marginLeft="3dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:textColor="@color/backgroundcolor"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:text="V 1.0.0"/>


            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:alpha=".6"
                app:layout_constraintTop_toBottomOf="@+id/msglayout"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/sidenavigationbottombanner" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>