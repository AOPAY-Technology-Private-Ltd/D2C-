<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bgcolor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backicon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:padding="4dp"
                android:src="@drawable/backarrow"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/flightdetails"
                android:textColor="@color/edtblack"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/backicon"
                app:layout_constraintLeft_toRightOf="@+id/backicon"
                app:layout_constraintTop_toTopOf="@+id/backicon" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/showingAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/orange"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerlayout">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/alert"
                android:layout_gravity="center"
                android:layout_marginLeft="15dp"
                app:tint="@color/red"/>
            <TextView
                android:id="@+id/alertmsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alert mag"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_gravity="center"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="15dp"/>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progresslayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintTop_toBottomOf="@+id/showingAlert">

            <LinearLayout
                android:id="@+id/firststep"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:orientation="vertical"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/selectedcircle"/>

            <TextView
                android:id="@+id/firststeptext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flight_details"
                android:textSize="13sp"
                android:textColor="@color/edtblack"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firststep"/>

            <View
                android:id="@+id/initialstepview"
                android:layout_width="0dp"
                android:layout_height="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@color/footer_unselected"
                app:layout_constraintRight_toLeftOf="@id/secondstep"
                app:layout_constraintLeft_toRightOf="@+id/firststep"/>

            <LinearLayout
                android:id="@+id/secondstep"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:orientation="vertical"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/unselctedcircle"/>

            <TextView
                android:id="@+id/secondsteptext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_passenger"
                android:textSize="13sp"
                android:textColor="@color/footer_unselected"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/secondstep"/>

            <View
                android:id="@+id/finalstepview"
                android:layout_width="0dp"
                android:layout_height="2dp"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/footer_unselected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@id/thirdstep"
                app:layout_constraintLeft_toRightOf="@+id/secondstep"/>

            <LinearLayout
                android:id="@+id/thirdstep"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:orientation="vertical"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/unselctedcircle"/>

            <TextView
                android:id="@+id/thirdsteptext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/make_payment"
                android:textSize="13sp"
                android:textColor="@color/footer_unselected"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/thirdstep"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_marginTop="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progresslayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="100dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/flightDetailsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/pickupdroplayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="6dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/editouterborder"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/airlineicon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="3dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            android:src="@drawable/airindia" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="5dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/airlineicon">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                                <TextView
                                    android:id="@+id/fromAirportCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DEL"
                                    android:textColor="@color/edtblack"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/roboto_bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_margin="6dp"
                                    android:src="@drawable/onestoparrow"
                                    app:tint="@color/edtblack" />

                                <TextView
                                    android:id="@+id/toAirportCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="4dp"
                                    android:text="BOM"
                                    android:textColor="@color/edtblack"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/roboto_bold" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/travelprimedetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fri,4 Jul | 19:10 - 01:05 | 5h 55m |1 Stop| Economy Class"
                                android:textColor="@color/edtblack"
                                android:textSize="12sp"
                                android:fontFamily="@font/roboto_regular"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="3dp"
                                    android:layout_margin="1dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingVertical="2dp"
                                        android:paddingHorizontal="2dp">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Check-in:"
                                            android:textSize="12sp"
                                            android:textColor="@color/edtblack"
                                            android:fontFamily="@font/roboto_regular"/>
                                        <TextView
                                            android:id="@+id/checkinbagweight"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="15 kg/Adult"
                                            android:textSize="10sp"
                                            android:textColor="@color/edtblack"
                                            android:fontFamily="@font/roboto_medium"/>
                                    </LinearLayout>


                                </androidx.cardview.widget.CardView>

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="10dp"/>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="3dp"
                                    android:layout_margin="1dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingVertical="2dp"
                                        android:paddingHorizontal="2dp">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Cabin:"
                                            android:textSize="12sp"
                                            android:textColor="@color/edtblack"
                                            android:fontFamily="@font/roboto_regular" />
                                        <TextView
                                            android:id="@+id/cabinbagweight"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="15 kg/Adult"
                                            android:textSize="10sp"
                                            android:textColor="@color/edtblack"
                                            android:fontFamily="@font/roboto_medium" />
                                    </LinearLayout>

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/detailstxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Details"
                            android:textSize="13sp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/primary_blue"
                            android:fontFamily="@font/roboto_regular"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintRight_toRightOf="parent"/>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/primaryContactDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/editouterborder"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="20dp"
                        app:layout_constraintTop_toBottomOf="@+id/pickupdroplayout">

                        <TextView
                            android:id="@+id/contactdetailstitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Primary Contact Details"
                            android:textColor="@color/edtblack"
                            android:textSize="17sp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/contactdetailssubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/ticketmsg"
                            android:textColor="@color/edtsubblack"
                            android:textSize="12sp"
                            android:layout_marginTop="5dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/contactdetailstitle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@+id/contactdetailssubtitle">

                            <TextView
                                android:id="@+id/adddetailsbutton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Details"
                                android:background="@drawable/selectedfrombox"
                                android:layout_marginTop="10dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/primary_blue"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/contactdetailssubtitle"/>

                            <LinearLayout
                                android:id="@+id/contactDetailslayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:layout_marginTop="10dp">

                                <TextView
                                    android:id="@+id/mobilenumber"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Mobile : 1234567890"
                                    android:textSize="14sp"
                                    android:textColor="@color/edtblack"
                                    android:fontFamily="@font/roboto_medium"/>

                                <TextView
                                    android:id="@+id/mailid"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Email ID : abcd@gmail.com"
                                    android:textSize="14sp"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/edtblack"
                                    android:fontFamily="@font/roboto_medium"/>

                            </LinearLayout>


                        </LinearLayout>

                        <TextView
                            android:id="@+id/edittxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:paddingVertical="6dp"
                            android:textColor="@color/primary_blue"
                            android:fontFamily="@font/roboto_regular"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintRight_toRightOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/contactdetailsvalidationlayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginHorizontal="15dp"
                        android:paddingVertical="3dp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/red"
                        android:visibility="gone"
                        android:text="Hey,please let us know the email and mobile no where we can send your e-ticket"
                        app:layout_constraintTop_toBottomOf="@+id/primaryContactDetails"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/pessangerDetailslayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="20dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/editouterborder"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/contactdetailsvalidationlayout">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="2dp"
                            android:layout_marginHorizontal="10dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            android:paddingHorizontal="10dp">
                            <TextView
                                android:id="@+id/numberOfPassemger"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="0/2"
                                android:textSize="13sp"
                                android:fontFamily="@font/roboto_medium"
                                android:textColor="@color/edtsubblack"/>
                            <TextView
                                android:id="@+id/ratingcount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/added"
                                android:fontFamily="@font/roboto_medium"
                                android:layout_marginLeft="5dp"
                                android:layout_gravity="center"
                                android:textSize="13sp"
                                android:textColor="@color/edtsubblack"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pessangertitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:text="Passenger Details"
                            android:layout_marginHorizontal="10dp"
                            android:textColor="@color/edtblack"
                            android:textSize="17sp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/pessangerdetailssubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginHorizontal="10dp"
                            android:text="@string/choose_from_saved_list"
                            android:textColor="@color/edtsubblack"
                            android:textSize="12sp"
                            android:layout_marginTop="5dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/pessangertitle" />

                        <LinearLayout
                            android:id="@+id/passengerDetailsListLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="10dp"
                            app:layout_constraintTop_toBottomOf="@+id/pessangerdetailssubtitle">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/orange">

                                <LinearLayout
                                    android:id="@+id/adultlayout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintLeft_toLeftOf="parent">
                                    <TextView
                                        android:id="@+id/adultcount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/roboto_regular"
                                        android:paddingVertical="6dp"
                                        android:paddingHorizontal="3dp"
                                        android:text="Adults: 0/2 "/>

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/childlayout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/adultlayout">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardCornerRadius="12dp"
                                        android:layout_gravity="center"
                                        app:cardBackgroundColor="@color/white"/>

                                    <TextView
                                        android:id="@+id/childcount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/roboto_regular"
                                        android:paddingVertical="6dp"
                                        android:paddingHorizontal="3dp"
                                        android:layout_marginLeft="5dp"
                                        android:text="Children: 0/1 "/>

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/infantlayout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintLeft_toRightOf="@+id/childlayout">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardCornerRadius="12dp"
                                        android:layout_gravity="center"
                                        app:cardBackgroundColor="@color/white"/>

                                    <TextView
                                        android:id="@+id/infantcount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/roboto_regular"
                                        android:paddingVertical="6dp"
                                        android:paddingHorizontal="3dp"
                                        android:layout_marginLeft="5dp"
                                        android:text="Infants: 0/1"/>

                                </LinearLayout>



                            </androidx.constraintlayout.widget.ConstraintLayout>


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/savedPassengerListShown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                tools:itemCount="3"
                                tools:listitem="@layout/passenger_saved_flight_item_layout"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintTop_toBottomOf="@+id/addnewbutton" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/addnewPassenger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Passenger"
                            android:layout_marginTop="10dp"
                            android:paddingHorizontal="4dp"
                            android:layout_marginHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/selectedfrombox"
                            android:textColor="@color/primary_blue"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/passengerDetailsListLayout"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/customervalidationlayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginHorizontal="15dp"
                        android:paddingVertical="3dp"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/red"
                        android:visibility="gone"
                        android:text="Passenger details are required to proceed"
                        app:layout_constraintTop_toBottomOf="@+id/pessangerDetailslayout"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/AddPassengerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                  <include
                      android:id="@+id/travellertypecontainer"
                      layout="@layout/traveller_type_layout" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.core.widget.NestedScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addpassengerBottomselection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/travelcardcolor"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/selectedseatLayout">

            <ImageView
                android:id="@+id/usericon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/profile"
                android:layout_marginLeft="13dp"
                android:background="@drawable/selectedcircle"
                app:tint="@color/primary_blue"
                android:padding="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:textColor="@color/primary_blue"
                android:fontFamily="@font/roboto_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/usericon"
                android:text="Choose from saved travellers"/>

            <ImageView
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:src="@drawable/arrowup"
                android:rotation="90"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selectedseatLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/farebreakup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/totalfaretxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/total_fare"
                    android:textAllCaps="false"
                    android:textColor="@color/edtsubblack"
                    android:textSize="14sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="15dp"
                    android:padding="2dp"
                    android:src="@drawable/infoicon"
                    app:layout_constraintLeft_toRightOf="@id/totalfaretxt"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/finalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="start"
                    android:paddingVertical="5dp"
                    android:text="₹ 6000"
                    android:textAllCaps="false"
                    android:textColor="@color/edtblack"
                    android:textSize="16sp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/totalfaretxt" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="end"
                    android:paddingVertical="5dp"
                    android:paddingStart="10sp"
                    android:text="+taxes"
                    android:textAllCaps="false"
                    android:textColor="@color/edtsubblack"
                    android:textSize="14sp"
                    app:layout_constraintLeft_toRightOf="@+id/finalAmount"
                    app:layout_constraintTop_toBottomOf="@+id/totalfaretxt" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/proceedBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/buttonshape"
                android:gravity="center"
                android:paddingHorizontal="30dp"
                android:paddingVertical="7dp"
                android:text="@string/proceed"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/farebreakup"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/farebreakup" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintTop_toBottomOf="@+id/proceedBtn" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>