<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha=".6"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/cancelimage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/cancel"
                android:layout_margin="5dp"
                android:padding="6dp"
                app:tint="@color/edtsubblack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Passenger"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_margin="5dp"
                android:padding="6dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:fontFamily="@font/roboto_bold"/>


            <LinearLayout
                android:id="@+id/topserviceslayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:weightSum="3"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@+id/cancelimage">


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/addPassengerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <RadioGroup
                            android:id="@+id/radiogroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginHorizontal="4dp"
                           app:layout_constraintTop_toTopOf="parent">

                            <RadioButton
                                android:id="@+id/male"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Male"
                                android:textSize="13sp"
                                android:fontFamily="@font/roboto_regular"/>

                            <RadioButton
                                android:id="@+id/female"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Female"
                                android:textSize="13sp"
                                android:fontFamily="@font/roboto_regular"/>

                        </RadioGroup>

                        <LinearLayout
                            android:id="@+id/firstnamelayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:background="@drawable/fromtoback"
                            android:layout_marginHorizontal="4dp"
                            app:layout_constraintTop_toBottomOf="@+id/radiogroup">

                            <EditText
                                android:id="@+id/passengerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:inputType="text"
                                android:textColor="@color/edtblack"
                                android:textSize="15sp"
                                android:imeOptions="actionNext"
                                android:background="@null"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/agelayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:background="@drawable/fromtoback"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/firstnamelayout">

                            <EditText
                                android:id="@+id/passengerAge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_regular"
                                android:inputType="number"
                                android:textColor="@color/edtblack"
                                android:textSize="15sp"
                                android:imeOptions="actionDone"
                                android:background="@null"/>

                        </LinearLayout>



                        <LinearLayout
                            android:id="@+id/updateBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:background="@drawable/buttonshape"
                            android:layout_marginHorizontal="5dp"
                            app:layout_constraintTop_toBottomOf="@+id/agelayout"
                            android:layout_marginBottom="30dp">

                            <TextView
                                android:id="@+id/updatetxt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:autoSizeTextType="uniform"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="Update"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>



            <View
                android:id="@+id/view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/cancel"
                android:layout_margin="5dp"
                android:padding="6dp"
                app:tint="@color/edtsubblack"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>