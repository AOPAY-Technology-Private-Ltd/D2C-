<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/itemlayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/editouterborder"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <TextView
            android:id="@+id/passengerSeatNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seat No 9"
            android:textColor="@color/edtblack"
            android:layout_marginLeft="2dp"
            android:fontFamily="@font/roboto_medium"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/checkImageView"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:padding="1dp"
                android:visibility="gone"
                android:src="@drawable/passengercheckicon" />

            <TextView
                android:id="@+id/passengerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Passenger"
                android:textColor="@color/edtsubblack"
                android:fontFamily="@font/roboto_regular"
                android:textSize="12sp"/>

        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>