<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/editouterborder">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_weight="1.5"
                android:layout_width="0dp"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/maintitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Top-Up your Wallet?"
                        android:textColor="@color/edtsubblack"
                        android:textSize="14dp"
                        android:fontFamily="@font/roboto_medium"/>


                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/easily_add_money"
                        android:textColor="@color/edtsubblack"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/roboto_regular"
                        app:layout_constraintLeft_toLeftOf="parent"/>

                </LinearLayout>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/expandimageview"
                android:layout_weight=".2"
                android:layout_width="0dp"
                android:gravity="right"
                android:layout_gravity="top"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/downupimageview"
                    android:layout_width="wrap_content"
                    android:src="@drawable/downbuttonicon"
                    app:tint="@color/black"
                    android:layout_gravity="right"
                    android:layout_height="20dp"/>

            </LinearLayout>

        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>