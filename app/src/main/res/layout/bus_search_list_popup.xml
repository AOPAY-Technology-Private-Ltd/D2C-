<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="50dp">


    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/cross"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:src="@drawable/cancel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Search Buses"
            android:textColor="@color/edtsubblack"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/fromcityLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fromtoback"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="6dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/fromlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageview"
                android:layout_weight=".1"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:padding="3dp"
                android:src="@drawable/fromiconbus" />

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_marginLeft="7dp"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/leaving_from"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fromcityname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Delhi"
                        android:textAllCaps="true"
                        android:fontFamily="@font/roboto_bold"
                        android:textColorHint="@color/black"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <com.example.twopayd2c.utils.searchableSp.SearchableSpinner
            android:id="@+id/fromDestinationSp"
            android:layout_width="match_parent"
            android:layout_height="?attr/dropdownListPreferredItemHeight"
            android:gravity="center"
            android:background="@null"
            android:visibility="gone"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tocityLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fromtoback"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/fromcityLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="6dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/tolayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_weight=".1"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:src="@drawable/tocitybus"
                app:tint="@color/edtsubblack"
                android:padding="3dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_marginLeft="7dp"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/going_to"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tocityname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Mumbai"
                        android:textAllCaps="true"
                        android:fontFamily="@font/roboto_bold"
                        android:textColorHint="@color/black"
                        android:textSize="14sp"/>


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        <com.example.twopayd2c.utils.searchableSp.SearchableSpinner
            android:id="@+id/toDestinationSp"
            android:layout_width="match_parent"
            android:layout_height="?attr/dropdownListPreferredItemHeight"
            android:gravity="center"
            android:background="@null"
            android:visibility="gone"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/reversetrip"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="6dp"
        app:cardCornerRadius="80dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tocityLayout"
        app:layout_constraintRight_toRightOf="@+id/fromcityLayout"
        app:layout_constraintTop_toTopOf="@+id/fromcityLayout">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/swapicon" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/dateselecetionlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/fromtoback"
        android:layout_marginTop="10dp"
        android:paddingVertical="6dp"
        android:layout_marginHorizontal="6dp"
        app:layout_constraintTop_toBottomOf="@+id/tocityLayout">

        <LinearLayout
            android:layout_weight=".9"
            android:id="@+id/departureDatelayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/fromcityLayout"
            android:layout_gravity="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <ImageView
                android:layout_weight=".2"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:padding="3dp"
                android:src="@drawable/calendaricon"
                android:layout_gravity="center"/>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/departuredate"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="12sp"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/datemonthdeparture"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:hint="28 Jun"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_bold"/>

                    <TextView
                        android:id="@+id/dayyear"
                        android:hint="Sat,2025"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginLeft="4dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:id="@+id/addreturndatelayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            app:layout_constraintTop_toBottomOf="@+id/fromcityLayout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_gravity="center">

            <LinearLayout
                android:id="@+id/todaylayout"
                android:layout_weight=".5"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:background="@drawable/editouterborder"
                android:layout_marginLeft="6dp"
                android:layout_gravity="center"
                android:paddingVertical="6dp"
                android:gravity="center"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/todaytxt"
                    android:text="TODAY"
                    android:layout_width="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="12sp"
                    android:textColor="@color/primary_blue"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tomorrowlayout"
                android:layout_weight=".5"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:background="@drawable/fromtoback"
                android:layout_marginLeft="6dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingVertical="6dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tomorrowtxt"
                    android:text="TOMMOROW"
                    android:layout_width="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="12sp"
                    android:textColor="@color/edtsubblack"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchbuseslayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/buttonshape"
        app:layout_constraintTop_toBottomOf="@+id/dateselecetionlayout">

        <TextView
            android:text="Modify Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/roboto_bold"
            android:padding="10dp"/>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>