<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.activity.travel.AllBusModule.AddPassengerPage">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bgcolor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backicon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/backarrow"
                android:layout_margin="10dp"
                android:padding="4dp"
                app:tint="@color/black"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Passengers"
                android:fontFamily="@font/roboto_medium"
                android:textSize="15sp"
                android:gravity="center"
                app:layout_constraintLeft_toRightOf="@+id/backicon"
                app:layout_constraintTop_toTopOf="@+id/backicon"
                app:layout_constraintBottom_toBottomOf="@+id/backicon"
                android:textColor="@color/edtblack"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight=".2"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center"
                android:layout_marginRight="15dp"
                android:orientation="vertical">


                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="2dp"
                        android:paddingHorizontal="10dp">
                        <TextView
                            android:id="@+id/numberOfPassemger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="0/2"
                            android:textSize="13sp"
                            android:fontFamily="@font/roboto_medium"
                            android:textColor="@color/edtsubblack"/>
                        <TextView
                            android:id="@+id/ratingcount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/added"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginLeft="5dp"
                            android:layout_gravity="center"
                            android:textSize="13sp"
                            android:textColor="@color/edtsubblack"/>
                    </LinearLayout>



            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/passengershowlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            tools:listitem="@layout/passenger_item_layout"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/headerlayout"/>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/passengerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/editouterborder"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:paddingVertical="15dp"
            app:layout_constraintTop_toBottomOf="@+id/passengershowlist">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addPassengerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/Addtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Passenger 1"
                    android:textColor="@color/edtsubblack"
                    android:textSize="16sp"
                    android:layout_marginHorizontal="7dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/roboto_medium"/>

                <RadioGroup
                    android:id="@+id/radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintTop_toBottomOf="@id/Addtitle">

                    <RadioButton
                        android:id="@+id/male"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Male"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                    <RadioButton
                        android:id="@+id/female"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Female"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto_regular"/>

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/firstnamelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/radiogroup">

                    <EditText
                        android:id="@+id/passengerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="First Name And Last Name"
                        android:inputType="text"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:background="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/agelayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:background="@drawable/fromtoback"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/firstnamelayout">

                    <EditText
                        android:id="@+id/passengerAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Age"
                        android:inputType="number"
                        android:textColor="@color/edtblack"
                        android:textSize="15sp"
                        android:imeOptions="actionDone"
                        android:background="@null"/>

                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkforsave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/edtblack"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="@string/save_this_detail_for_future_bookings"
                    app:layout_constraintTop_toBottomOf="@+id/agelayout"/>

                <LinearLayout
                    android:id="@+id/nextBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/buttonshape"
                    android:backgroundTint="@color/disablebuttoncolor"
                    android:layout_marginHorizontal="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/checkforsave"
                    android:layout_marginBottom="30dp">

                    <TextView
                        android:id="@+id/nextbutton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Add"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addedPassengerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/savedPassengertitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved Passengers"
                    android:textColor="@color/edtsubblack"
                    android:textSize="16sp"
                    android:layout_marginHorizontal="7dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/roboto_medium"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/addnewbutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="7dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/primary_blue"
                    app:layout_constraintBottom_toBottomOf="@+id/savedPassengertitle"
                    app:layout_constraintTop_toTopOf="@+id/savedPassengertitle"
                    app:layout_constraintRight_toRightOf="parent">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="3dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/plus_icon"
                            app:tint="@color/white"
                            android:padding="1dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New"
                            android:textColor="@color/white"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginRight="4dp"
                            android:textSize="13sp"/>
                    </LinearLayout>


                </androidx.cardview.widget.CardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/savedPassengerListShown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="7dp"
                    tools:listitem="@layout/passenger_saved_item_layout"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/addnewbutton"
                  />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/continuelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/buttonshape"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continued"
                android:layout_gravity="center"
                android:padding="8dp"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="@font/roboto_bold"
                android:autoSizeTextType="uniform"
                android:gravity="center"/>

        </LinearLayout>


        <ImageView
            android:id="@+id/busimage"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:padding="30dp"
            android:src="@drawable/busiconforplaceholder"
            app:layout_constraintTop_toBottomOf="@+id/passengerContainer"
            app:layout_constraintLeft_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>