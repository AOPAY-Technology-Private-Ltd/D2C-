<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bgcolor"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="7dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp">

            <ImageView
                android:id="@+id/checkImageView"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:padding="5dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/payouticon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/checkImageView">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:paddingVertical="5dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/remarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Payout"
                        android:textColor="@color/edtsubblack"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/transactionid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/txtcolor"
                        android:fontFamily="@font/roboto_regular"
                        android:text="7982144432@ptaxis"/>

                    <TextView
                        android:id="@+id/refid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="REF ID BTERF00632"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/button_text_gray"
                        android:fontFamily="@font/roboto_regular"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_gravity="bottom"
                    android:paddingVertical="5dp"
                    android:layout_marginRight="10dp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_gravity="right">

                        <TextView
                            android:id="@+id/amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/dark_green"
                            android:fontFamily="@font/roboto_medium"
                            android:text="+₹ 1"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:rotation="270"
                            android:layout_gravity="center"
                            android:alpha=".8"
                            android:src="@drawable/arrowdown"/>

                    </LinearLayout>


                    <TextView
                        android:id="@+id/date"
                        android:layout_gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apr 15,2026, 12:11 PM"
                        android:textSize="@dimen/dimen_12sp"
                        android:textColor="@color/button_text_gray"
                        android:fontFamily="@font/roboto_regular"/>


                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>