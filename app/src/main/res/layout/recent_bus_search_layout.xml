<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:background="@drawable/editouterborder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <TextView
            android:id="@+id/Fromcityname"
            android:text="Delhi"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/edtblack"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/nextarrow"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:src="@drawable/nextarrow"
            app:tint="@color/black"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="@id/Fromcityname"
            app:layout_constraintTop_toTopOf="@id/Fromcityname"
            app:layout_constraintLeft_toRightOf="@id/Fromcityname"/>

        <TextView
            android:id="@+id/Tocityname"
            android:text="Mumbai"
            app:layout_constraintTop_toTopOf="@id/Fromcityname"
            app:layout_constraintLeft_toRightOf="@id/nextarrow"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/edtblack"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/searchdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Thu,5th Feb"
            android:textSize="11sp"
            android:textColor="@color/edtsubblack"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Tocityname"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>