<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/droplayout"
    android:visibility="gone"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/genderquestiontitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drop_points"
        android:textSize="15sp"
        android:fontFamily="@font/roboto_bold"
        android:gravity="left"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textColor="@color/edtblack"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dropshowlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/pickup_dropup_itemlayout"
        app:layout_constraintTop_toBottomOf="@+id/genderquestiontitle"
        app:layout_constraintBottom_toBottomOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>